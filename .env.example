OPENBACKEND_HOST=127.0.0.1
OPENBACKEND_PORT=8787
OPENBACKEND_DATA_DIR=./data
OPENBACKEND_PUBLIC_URL=http://localhost:8787
OPENBACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
OPENBACKEND_DEPLOY_SIZE=local
OPENBACKEND_REQUIRE_AUTH=true
OPENBACKEND_REQUIRE_WRITE_AUTH=true
OPENBACKEND_MAX_UPLOAD_BYTES=10485760
OPENBACKEND_BACKUP_DIR=./backups
OPENBACKEND_SESSION_TTL_HOURS=168
OPENBACKEND_RATE_LIMIT_WINDOW_MS=60000
OPENBACKEND_RATE_LIMIT_MAX=120
OPENBACKEND_FUNCTION_TIMEOUT_MS=5000
OPENBACKEND_REQUIRE_REALTIME_AUTH=true

# Optional scale-up services. These are open-source/self-hosted and disabled
# until you run `npm run deploy -- nas` or `npm run deploy -- vps`.
MINIO_ROOT_USER=openbackend
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_DB=openbackend
POSTGRES_USER=openbackend
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432
